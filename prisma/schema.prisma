generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Player {
  id             String     @id @default(cuid())
  tokenHash      String     @unique
  name           String
  tag            String     @unique
  siclos         Int        @default(0)
  streak         Int        @default(0)
  bestStreak     Int        @default(0)
  lastPlayedAt   DateTime?
  // Cosméticos equipados del Gazofilacio: el marco rodea las iniciales y el
  // título acompaña al nombre en el Salón de la Sabiduría. Dos columnas
  // porque se equipan en paralelo (marco y título a la vez).
  equippedMarco  String?
  equippedTitulo String?
  createdAt      DateTime   @default(now())
  games          Game[]
  purchases      Purchase[]
}

model Question {
  id        String   @id
  level     Int
  category  String
  prompt    String
  options   String[]
  answer    Int
  reference String
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([level, active])
}

model Game {
  id         String    @id @default(cuid())
  playerId   String
  player     Player    @relation(fields: [playerId], references: [id])
  status     String    @default("playing")
  level      Int       @default(1)
  amount     Int       @default(0)
  siclos     Int       @default(0)
  version    Int       @default(0)
  rounds     Json
  lifelines  String[]  @default([])
  // Bendiciones ofrendadas en el recorrido (lampara, sol, redencion),
  // al estilo del arreglo lifelines de los comodines de la casa.
  bendiciones String[] @default([])
  removed    Int[]     @default([])
  deadline   DateTime
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([playerId, createdAt])
  @@index([status, amount, finishedAt])
}

// Historial de compras y ofrendas del Gazofilacio (v1.2). Una fila por cada
// gasto: cosméticos comprados en la tienda y bendiciones cobradas en partida
// (con gameId cuando aplica). Permite histórico, métricas y auditoría sin
// recalcular nada. gameId es una referencia informática sin llave foránea:
// las partidas se limpian en pruebas sin arrastrar el historial.
model Purchase {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  item      String
  price     Int
  gameId    String?
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
}